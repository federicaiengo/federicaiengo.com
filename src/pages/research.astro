em 1.1rem 5rem}.intro{margin-bottom:4rem}.grid{grid-template-columns:1fr}.card{min-height:0}.principles,.next{margin-top:4rem}.next{padding:1.6rem}}
.fieldwork{margin-top:6rem;border-top:1px solid #36322b;padding-top:3.5rem}.field-grid{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:1rem;margin-top:2rem}.field-grid article{padding:1.7rem;border:1px solid #302d26;border-radius:12px;background:#10100e}.field-grid span{font-size:.75rem;color:#d6b86a;letter-spacing:.1em}.field-grid h3{margin:1rem 0 .5rem;font-size:1.23rem}.field-grid p{line-height:1.7;color:#bcbcbc}@media(max-width:600px){.field-grid{grid-template-columns:1fr}.fieldwork{margin-top:4rem}}</style>
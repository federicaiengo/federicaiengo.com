---
const { title, description } = Astro.props;
const canonical = new URL(Astro.url.pathname, Astro.site);
---
<!doctype html><html lang="en"><head><meta charset="UTF-8"><meta name="viewport" content="width=device-width"><title>{title}</title><meta name="description" content={description}><link rel="canonical" href={canonical}><meta property="og:title" content={title}><meta property="og:description" content={description}><meta property="og:type" content="website"><meta property="og:url" content={canonical}></head><body><header><a href="/">Federica Iengo</a><nav><a href="/projects">Projects</a><a href="/research">Research</a><a href="/ai-search">AI Search</a><a href="/about">About</a></nav></header><main><slot /></main><footer>Federica Iengo · Data Analytics & AI Search</footer></body></html>
<style is:global>html{font-family:Inter,system-ui,sans-serif;background:#090909;color:#f5f5f5}body{max-width:1120px;margin:auto;padding:28px}a{color:inherit}header{display:flex;justify-content:space-between;gap:24px}nav{display:flex;gap:18px;flex-wrap:wrap}main{min-height:75vh;padding:9vh 0}h1{font-size:clamp(2.8rem,8vw,6.5rem);line-height:.95;max-width:950px}h2{font-size:2rem}p{color:#c8c8c8;line-height:1.65;max-width:760px}.eyebrow{color:#d7b86a;text-transform:uppercase;letter-spacing:.14em}.grid{display:grid;grid-template-columns:repeat(auto-fit,minmax(250px,1fr));gap:20px}.card{border:1px solid #333;padding:24px;border-radius:18px;background:#101010}footer{border-top:1px solid #262626;padding:28px 0;color:#888}</style>
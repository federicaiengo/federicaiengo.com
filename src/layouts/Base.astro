---
const { title, description } = Astro.props;
const canonical = new URL(Astro.url.pathname, Astro.site);
---
<!doctype html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>{title}</title>
<meta name="description" content={description}>
<link rel="canonical" href={canonical}>
<meta property="og:title" content={title}>
<meta property="og:description" content={description}>
<meta property="og:type" content="website">
<meta property="og:url" content={canonical}>
</head>
<body>
<header class="site-header">
<a class="brand" href="/" aria-label="Federica Iengo home"><span>Federica</span> Iengo</a>
<nav aria-label="Primary navigation"><a href="/projects">Projects</a><a href="/research">Research</a><a href="/ai-search">AI Search</a><a href="/about">About</a></nav>
</header>
<main><slot /></main>
<footer><span>Federica Iengo</span><span>Data Analytics & AI Search</span></footer>
</body>
</html>
<style is:global>
:root{color-scheme:dark;--bg:#050505;--surface:#0b0b0b;--surface-2:#111;--text:#f3f1ec;--muted:#aaa8a2;--line:#292720;--gold:#d6b86a;--gold-soft:#8d7845;--measure:760px}
*{box-sizing:border-box}
html{font-family:Manrope,Inter,ui-sans-serif,system-ui,-apple-system,BlinkMacSystemFont,"Segoe UI",sans-serif;background:var(--bg);color:var(--text);scroll-behavior:smooth}
body{max-width:1180px;margin:0 auto;padding:0 34px;background:radial-gradient(circle at 82% 0%,rgba(214,184,106,.055),transparent 28rem),var(--bg)}
a{color:inherit;text-decoration-color:var(--gold-soft);text-underline-offset:.22em}
a:hover{color:#fff;text-decoration-color:var(--gold)}
.site-header{min-height:92px;display:flex;align-items:center;justify-content:space-between;gap:28px;border-bottom:1px solid #171717}
.brand{font-weight:700;letter-spacing:-.025em;text-decoration:none;font-size:1.08rem}.brand span{color:var(--gold)}
nav{display:flex;gap:24px;flex-wrap:wrap}nav a{text-decoration:none;color:#aaa;font-size:.92rem;font-weight:600}nav a:hover{color:var(--text)}
main{min-height:75vh;padding:clamp(64px,9vw,116px) 0 110px}
h1,h2,h3{letter-spacing:-.035em;text-wrap:balance}
h1{font-size:clamp(3.1rem,7.7vw,6.8rem);line-height:.93;max-width:1000px;margin:.22em 0 .35em;font-weight:750}
h2{font-size:clamp(1.8rem,4vw,2.65rem);line-height:1.08;margin:3.2rem 0 1rem}
h3{font-size:1.14rem;line-height:1.25;margin:.15rem 0 .8rem}
p{color:var(--muted);line-height:1.72;max-width:var(--measure);font-size:1.01rem}
strong{color:#dedbd2;font-weight:650}
.eyebrow{color:var(--gold);text-transform:uppercase;letter-spacing:.16em;font-size:.72rem;font-weight:750;line-height:1.5}
.grid{display:grid;grid-template-columns:repeat(auto-fit,minmax(255px,1fr));gap:16px;margin:1.7rem 0 2.5rem}
.card{position:relative;border:1px solid var(--line);padding:25px;border-radius:14px;background:linear-gradient(145deg,#0d0d0d,#090909);min-height:155px;transition:transform .18s ease,border-color .18s ease,background .18s ease}
.card:before{content:"";position:absolute;left:25px;top:0;width:38px;height:1px;background:var(--gold-soft)}
.card:hover{transform:translateY(-2px);border-color:#4a4432;background:#0e0e0d}
.card p{font-size:.94rem;margin-bottom:0}
.card .eyebrow{font-size:.64rem;margin:0 0 .75rem}
footer{border-top:1px solid #1d1d1d;padding:30px 0 38px;color:#777;display:flex;justify-content:space-between;gap:18px;font-size:.83rem}
::selection{background:#6f5c2c;color:#fff}
@media(max-width:680px){body{padding:0 20px}.site-header{min-height:78px;align-items:flex-start;padding:22px 0;flex-direction:column;gap:15px}nav{gap:16px}main{padding-top:64px}h1{font-size:clamp(2.7rem,14vw,4.5rem)}h2{margin-top:2.7rem}.grid{grid-template-columns:1fr}.card{padding:21px;min-height:0}.card:before{left:21px}footer{flex-direction:column}}
@media(prefers-reduced-motion:reduce){html{scroll-behavior:auto}.card{transition:none}.card:hover{transform:none}}
</style>